{
  "name": "themespace-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "npm run build:dev && node tests/e2e.mjs",
    "e2e:studio": "npm run build:dev && node tests/e2e-studio.mjs",
    "e2e:real": "npm run build:dev && node tests/e2e-real.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "pack:web": "node scripts/build.mjs --pack ../web/public/downloads",
    "pack:store": "node scripts/build.mjs --pack dist/store --source dist/store/themespace-companion-source.zip",
    "store:assets": "npm run build:dev && node scripts/capture-store-assets.mjs && npm run pack:store"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/jsdom": "^30.0.0",
    "esbuild": "0.25.12",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.59.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  }
}
